rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The activity calendar reads this collection in the browser.
    // The Strava webhook writes it with the Admin SDK, which bypasses rules.
    match /activities/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    // Strava OAuth tokens (config/stravaTokens). Admin SDK only.
    // allow if false does not override a broader allow; do not add one that matches this path.
    match /config/{document} {
      allow read, write: if false;
    }

    // Goodreads shelf written by functions/goodreads (Admin SDK bypasses rules).
    match /reading/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny every other path. Unmatched paths are already denied; this keeps that explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
